# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything except the checked-in example template
.env*
!.env.example

# vercel
.vercel

# superpowers brainstorming companion
.superpowers/

# local tooling artifacts — not part of the app
.claude/
graphify-out/
obsidian-vault/
AGENTS.md
CLAUDE.md
docs/brief.txt

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# working source material — briefs and raw footage kept beside the project,
# never shipped. The encoded walkthroughs that DO ship live in public/videos.
*.docx
# raw footage dropped at the repo root — the encoded copies that ship live
# in public/videos/, which this pattern deliberately does not touch.
/*.mp4
/*.mov

# local dev/prod server logs (written by `next dev` / `next start` during
# local verification; never part of the app)
/dev.log
/prod.log
