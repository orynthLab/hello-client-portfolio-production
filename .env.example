# Copy this file to .env.local and fill in real values for local development.
# .env.local is git-ignored — never commit real values.

# Web3Forms access key (used by the site's Contact modal to deliver form
# submissions by email — no backend required). Get a free key at
# https://web3forms.com by entering the email that should receive submissions.
# This is a client-side/public key by design (same category as a reCAPTCHA
# site key), not a traditional secret — see the comment in ContactModal.tsx.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
